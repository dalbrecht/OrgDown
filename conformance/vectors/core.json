{
  "module": "core",
  "op": "parse",
  "cases": [
    {"id": "plain-task", "input": "- [ ] Buy milk", "expect": {"kinds": ["task"], "tasks": [{"title": "Buy milk", "state": "inbox", "depth": 0, "checked": false, "extraTokens": []}]}},
    {"id": "markers-and-boxes", "input": "* [ ] a\n+ [x] b\n- [X] c", "expect": {"kinds": ["task", "task", "task"], "tasks": [{"marker": "*", "state": "inbox"}, {"marker": "+", "state": "done", "checked": true}, {"marker": "-", "state": "done", "checked": true}]}},
    {"id": "ordered-item-is-not-a-task", "input": "1. [ ] a", "expect": {"kinds": ["passthrough"], "tasks": []}},
    {"id": "box-with-no-space-is-not-a-task", "input": "- [ ]", "expect": {"kinds": ["passthrough"], "tasks": []}},
    {"id": "empty-title-is-a-task", "input": "- [ ] ", "expect": {"kinds": ["task"], "tasks": [{"title": ""}]}},
    {"id": "section-levels", "input": "## A\n# B\n###### C\n####### D\n##", "expect": {"kinds": ["section", "passthrough", "section", "passthrough", "passthrough"], "tasks": []}},
    {"id": "trailing-newline-is-an-empty-line", "input": "- [ ] a\n", "expect": {"kinds": ["task", "passthrough"], "tasks": [{"title": "a"}]}},
    {"id": "carriage-return-ignored", "input": "- [ ] a due:2026-11-04\r\n- [ ] b\r", "expect": {"kinds": ["task", "task"], "tasks": [{"title": "a", "due": "2026-11-04"}, {"title": "b"}]}},
    {"id": "front-matter-is-opaque", "input": "---\n- [ ] not a task\n---\n- [ ] task", "expect": {"kinds": ["opaque", "opaque", "opaque", "task"], "tasks": [{"title": "task"}]}},
    {"id": "rule-not-on-first-line-is-not-front-matter", "input": "\n---\n- [ ] task\n---", "expect": {"kinds": ["passthrough", "passthrough", "task", "passthrough"], "tasks": [{"title": "task"}]}},
    {"id": "backtick-fence-is-opaque", "input": "```markdown\n- [ ] no\n```\n- [ ] yes", "expect": {"kinds": ["opaque", "opaque", "opaque", "task"], "tasks": [{"title": "yes"}]}},
    {"id": "tilde-fence-needs-tilde-close", "input": "~~~\n```\n- [ ] no\n~~~\n- [ ] yes", "expect": {"kinds": ["opaque", "opaque", "opaque", "opaque", "task"], "tasks": [{"title": "yes"}]}},
    {"id": "longer-fence-needs-long-close", "input": "````\n```\n- [ ] no\n````\n- [ ] yes", "expect": {"kinds": ["opaque", "opaque", "opaque", "opaque", "task"], "tasks": [{"title": "yes"}]}},
    {"id": "indented-fence-is-opaque", "input": "- [ ] a\n  ```\n  - [ ] no\n  ```", "expect": {"kinds": ["task", "opaque", "opaque", "opaque"], "tasks": [{"title": "a"}]}},
    {"id": "unclosed-fence-runs-to-end", "input": "```\n- [ ] no\n## nor this", "expect": {"kinds": ["opaque", "opaque", "opaque"], "tasks": []}},
    {"id": "comment-block-is-opaque", "input": "<!--\n- [ ] no\n-->\n- [ ] yes", "expect": {"kinds": ["opaque", "opaque", "opaque", "task"], "tasks": [{"title": "yes"}]}},
    {"id": "one-line-comment-is-passthrough", "input": "<!-- note -->\n- [ ] yes", "expect": {"kinds": ["passthrough", "task"], "tasks": [{"title": "yes"}]}},
    {"id": "generated-region-is-opaque", "input": "<!-- orgdown:view day -->\n- [ ] no\n<!-- /orgdown:view -->\n- [ ] yes", "expect": {"kinds": ["opaque", "opaque", "opaque", "task"], "tasks": [{"title": "yes"}]}},
    {"id": "nesting-two-spaces", "input": "- [ ] a\n  - [ ] b\n    - [ ] c\n  - [ ] d\n- [ ] e", "expect": {"tasks": [{"title": "a", "depth": 0, "parent": null}, {"title": "b", "depth": 1, "parent": 1}, {"title": "c", "depth": 2, "parent": 2}, {"title": "d", "depth": 1, "parent": 1}, {"title": "e", "depth": 0, "parent": null}]}},
    {"id": "tab-is-two-columns", "input": "- [ ] a\n\t- [ ] b", "expect": {"tasks": [{"depth": 0}, {"depth": 1, "parent": 1}]}},
    {"id": "odd-indent-rounds-down", "input": "- [ ] a\n   - [ ] b", "expect": {"tasks": [{"depth": 0}, {"depth": 1, "parent": 1}]}},
    {"id": "one-space-is-not-nested", "input": "- [ ] a\n - [ ] b", "expect": {"tasks": [{"depth": 0}, {"depth": 0, "parent": null}]}},
    {"id": "section-ends-scope", "input": "- [ ] a\n## S\n  - [ ] b", "expect": {"tasks": [{"title": "a"}, {"title": "b", "depth": 1, "parent": null}]}},
    {"id": "passthrough-keeps-scope", "input": "- [ ] a\nprose\n  - [ ] b", "expect": {"tasks": [{"title": "a"}, {"title": "b", "parent": 1}]}},
    {"id": "gap-in-depth", "input": "- [ ] a\n    - [ ] b\n  - [ ] c", "expect": {"tasks": [{"depth": 0}, {"depth": 2, "parent": 1}, {"depth": 1, "parent": 1}]}},
    {"id": "all-core-tokens", "input": "- [ ] Title @status:waiting @context:Home @energy:high @waiting:\"Bob to reply\" due:2026-07-01 defer:2026-06-20 @kind:project", "expect": {"tasks": [{"title": "Title", "state": "waiting", "context": "Home", "energy": "high", "waitingReason": "Bob to reply", "due": "2026-07-01", "defer": "2026-06-20", "nodeKind": "project", "extraTokens": []}]}},
    {"id": "every-status", "input": "- [ ] a @status:inbox\n- [ ] b @status:next\n- [ ] c @status:in-progress\n- [ ] d @status:blocked\n- [ ] f @status:someday\n- [ ] g @status:done\n- [x] h @status:trash", "expect": {"tasks": [{"state": "inbox"}, {"state": "next"}, {"state": "in-progress"}, {"state": "blocked"}, {"state": "someday"}, {"state": "done"}, {"state": "trash"}]}},
    {"id": "status-wins-over-box", "input": "- [x] a @status:next\n- [ ] b @status:done", "expect": {"tasks": [{"state": "next"}, {"state": "done"}]}},
    {"id": "token-order-is-free", "input": "- [ ] a due:2026-11-04 @status:next @context:x", "expect": {"tasks": [{"state": "next", "due": "2026-11-04", "context": "x"}]}},
    {"id": "legacy-project", "input": "- [ ] a @project:Reno", "expect": {"tasks": [{"project": "Reno"}]}},
    {"id": "single-action-kind", "input": "- [ ] a @kind:single-action", "expect": {"tasks": [{"nodeKind": "single-action"}]}},
    {"id": "tag-after-token-ends-the-run", "input": "- [ ] Buy milk @context:errands #home", "expect": {"tasks": [{"title": "Buy milk @context:errands #home", "context": null, "tags": ["home"], "extraTokens": []}]}},
    {"id": "email-in-title", "input": "- [ ] Email foo@bar.com re: the plan @context:Calls", "expect": {"tasks": [{"title": "Email foo@bar.com re: the plan", "context": "Calls"}]}},
    {"id": "word-after-colon-word-stays-title", "input": "- [ ] Call Bob re: budget", "expect": {"tasks": [{"title": "Call Bob re: budget", "extraTokens": []}]}},
    {"id": "trailing-colon-word-is-a-token", "input": "- [ ] Call Bob re:", "expect": {"tasks": [{"title": "Call Bob", "extraTokens": ["re:"]}]}},
    {"id": "url-at-end-is-a-token", "input": "- [ ] Read https://example.com/a", "expect": {"tasks": [{"title": "Read", "extraTokens": ["https://example.com/a"]}]}},
    {"id": "wrapped-url-stays-title", "input": "- [ ] Read <https://example.com/a>", "expect": {"tasks": [{"title": "Read <https://example.com/a>", "extraTokens": []}]}},
    {"id": "inline-code-token-stays-title", "input": "- [ ] Explain the `due:2026-01-01` syntax", "expect": {"tasks": [{"title": "Explain the `due:2026-01-01` syntax", "due": null}]}},
    {"id": "title-whitespace-collapses", "input": "- [ ]   Two   spaces   due:2026-11-04", "expect": {"tasks": [{"title": "Two spaces", "due": "2026-11-04"}]}},
    {"id": "unknown-tokens-kept-in-order", "input": "- [ ] x @context:Home @bogus:nope due:2026-07-01 @x-mine:1", "expect": {"tasks": [{"context": "Home", "due": "2026-07-01", "extraTokens": ["@bogus:nope", "@x-mine:1"]}]}},
    {"id": "invalid-values-are-extras", "input": "- [ ] x @status:frozen due:2026-13-40 defer:2026-02-30 @energy:huge @kind:folder", "expect": {"tasks": [{"state": "inbox", "due": null, "defer": null, "energy": null, "nodeKind": null, "extraTokens": ["@status:frozen", "due:2026-13-40", "defer:2026-02-30", "@energy:huge", "@kind:folder"]}]}},
    {"id": "keys-are-case-sensitive", "input": "- [ ] x @Status:next DUE:2026-11-04", "expect": {"tasks": [{"title": "x", "state": "inbox", "due": null, "extraTokens": ["@Status:next", "DUE:2026-11-04"]}]}},
    {"id": "leap-day-validity", "input": "- [ ] a due:2028-02-29\n- [ ] b due:2026-02-29", "expect": {"tasks": [{"due": "2028-02-29"}, {"due": null, "extraTokens": ["due:2026-02-29"]}]}},
    {"id": "last-valid-duplicate-wins", "input": "- [ ] x due:2026-10-24 due:2026-10-31", "expect": {"tasks": [{"due": "2026-10-31", "extraTokens": []}]}},
    {"id": "invalid-duplicate-does-not-displace", "input": "- [ ] x due:2026-10-24 due:nope", "expect": {"tasks": [{"due": "2026-10-24", "extraTokens": ["due:nope"]}]}},
    {"id": "waiting-without-reason-falls-back", "input": "- [ ] x @status:waiting", "expect": {"tasks": [{"state": "inbox", "extraTokens": ["@status:waiting"]}]}},
    {"id": "waiting-fallback-goes-after-extras", "input": "- [x] x @bogus:1 @status:waiting @other:2", "expect": {"tasks": [{"state": "done", "extraTokens": ["@bogus:1", "@other:2", "@status:waiting"]}]}},
    {"id": "blank-waiting-reason-is-invalid", "input": "- [ ] x @status:waiting @waiting:\" \"", "expect": {"tasks": [{"state": "inbox", "waitingReason": null, "extraTokens": ["@waiting:\" \"", "@status:waiting"]}]}},
    {"id": "unquoted-waiting-reason", "input": "- [ ] x @status:waiting @waiting:Bob", "expect": {"tasks": [{"state": "waiting", "waitingReason": "Bob"}]}},
    {"id": "reason-without-status-keeps-box-state", "input": "- [ ] x @waiting:Bob", "expect": {"tasks": [{"state": "inbox", "waitingReason": "Bob"}]}},
    {"id": "quoted-context", "input": "- [ ] x @context:\"Home Office\" due:2026-11-04", "expect": {"tasks": [{"context": "Home Office", "due": "2026-11-04"}]}},
    {"id": "bare-context-with-space-is-title", "input": "- [ ] x @context:Home Office", "expect": {"tasks": [{"title": "x @context:Home Office", "context": null}]}},
    {"id": "trailer", "input": "- [ ] x due:2026-11-04 <!-- id:a1 rev:sha256:r7 -->", "expect": {"tasks": [{"title": "x", "due": "2026-11-04", "id": "a1", "rev": "sha256:r7"}]}},
    {"id": "trailer-without-fields", "input": "- [ ] x <!-- a note -->", "expect": {"tasks": [{"title": "x", "id": null, "rev": null}]}},
    {"id": "tags-in-order-without-duplicates", "input": "- [ ] Plan #work/q4 trip #home #work/q4 due:2026-11-04", "expect": {"tasks": [{"title": "Plan #work/q4 trip #home #work/q4", "tags": ["work/q4", "home"]}]}},
    {"id": "not-tags", "input": "- [ ] Issue #42 and foo#bar and `#code` and #home,", "expect": {"tasks": [{"tags": []}]}},
    {"id": "unicode-tag", "input": "- [ ] Résumé #été", "expect": {"tasks": [{"tags": ["été"]}]}},
    {"id": "unclosed-front-matter-is-not-front-matter", "input": "---\n- [ ] task", "expect": {"kinds": ["passthrough", "task"], "tasks": [{"title": "task"}]}},
    {"id": "unclosed-comment-runs-to-end", "input": "<!--\n- [ ] no", "expect": {"kinds": ["opaque", "opaque"], "tasks": []}},
    {"id": "unclosed-region-runs-to-end", "input": "<!-- orgdown:view day -->\n- [ ] no", "expect": {"kinds": ["opaque", "opaque"], "tasks": []}},
    {"id": "last-trailer-field-wins", "input": "- [ ] x <!-- id:a id:b rev:1 rev:2 -->", "expect": {"tasks": [{"id": "b", "rev": "2"}]}},
    {"id": "empty-context-is-valid", "input": "- [ ] x @context:", "expect": {"tasks": [{"context": "", "extraTokens": []}]}},
    {"id": "shadowed-duplicate-is-not-an-extra", "input": "- [ ] x @context:a @context:b", "expect": {"tasks": [{"context": "b", "extraTokens": []}]}},
    {"id": "progress-counts-direct-children", "input": "- [ ] P\n  - [x] a\n    - [ ] deep\n  - [ ] b\n  - [ ] c @status:trash", "expect": {"tasks": [{"progress": {"done": 2, "total": 3}}, {"progress": {"done": 0, "total": 1}}, {"progress": null}, {"progress": null}, {"progress": null}]}},
    {"id": "legacy-project-keeps-its-quotes", "input": "- [ ] T @project:\"Home Office\"", "expect": {"tasks": [{"project": "\"Home Office\""}]}},
    {"id": "colon-word-inside-a-quoted-value", "input": "- [ ] x @waiting:\"call re: budget\"", "expect": {"tasks": [{"title": "x @waiting:\"call re: budget\"", "waitingReason": null}]}}
  ]
}
