{
  "module": "recurrence",
  "op": "mixed",
  "cases": [
    {"id": "read-every", "op": "parse", "input": "- [ ] a @every:1w", "expect": {"tasks": [{"recurrence": {"mode": "due", "every": 1, "unit": "week"}}]}},
    {"id": "read-after", "op": "parse", "input": "- [ ] a @after:3m", "expect": {"tasks": [{"recurrence": {"mode": "completion", "every": 3, "unit": "month"}}]}},
    {"id": "read-days", "op": "parse", "input": "- [ ] a @every:10d", "expect": {"tasks": [{"recurrence": {"mode": "due", "every": 10, "unit": "day"}}]}},
    {"id": "read-full-rule", "op": "parse", "input": "- [ ] a @every:2w @repeat-on:thu,mon,thu @repeat-until:2026-12-31 @repeat-count:5", "expect": {"tasks": [{"recurrence": {"mode": "due", "every": 2, "unit": "week", "weekdays": [1, 4], "until": "2026-12-31", "count": 5}}]}},
    {"id": "read-catch-up", "op": "parse", "input": "- [ ] a @every:1w @repeat-catch-up:yes", "expect": {"tasks": [{"recurrence": {"mode": "due", "every": 1, "unit": "week", "catchUp": true}}]}},
    {"id": "no-rule", "op": "parse", "input": "- [ ] a", "expect": {"tasks": [{"recurrence": null}]}},
    {"id": "zero-interval-is-invalid", "op": "parse", "input": "- [ ] a @every:0w", "expect": {"tasks": [{"recurrence": null, "extraTokens": ["@every:0w"]}]}},
    {"id": "yearly-unit-is-invalid", "op": "parse", "input": "- [ ] a @every:1y", "expect": {"tasks": [{"recurrence": null, "extraTokens": ["@every:1y"]}]}},
    {"id": "last-valid-primary-wins", "op": "parse", "input": "- [ ] a @every:1w @after:2d", "expect": {"tasks": [{"recurrence": {"mode": "completion", "every": 2, "unit": "day"}}]}},
    {"id": "invalid-primary-does-not-displace", "op": "parse", "input": "- [ ] a @every:1w @after:0w", "expect": {"tasks": [{"recurrence": {"mode": "due", "every": 1, "unit": "week"}, "extraTokens": ["@after:0w"]}]}},
    {"id": "malformed-weekday-list", "op": "parse", "input": "- [ ] a @every:1w @repeat-on:mon,funday", "expect": {"tasks": [{"recurrence": {"mode": "due", "every": 1, "unit": "week"}, "extraTokens": ["@repeat-on:mon,funday"]}]}},
    {"id": "negative-count", "op": "parse", "input": "- [ ] a @every:1w @repeat-count:-1", "expect": {"tasks": [{"recurrence": {"mode": "due", "every": 1, "unit": "week"}, "extraTokens": ["@repeat-count:-1"]}]}},
    {"id": "orphan-repeat-tokens", "op": "parse", "input": "- [ ] a @repeat-count:3 @repeat-on:mon", "expect": {"tasks": [{"recurrence": null, "extraTokens": ["@repeat-count:3", "@repeat-on:mon"]}]}},
    {"id": "weekdays-need-week-unit", "op": "parse", "input": "- [ ] a @every:1m @repeat-on:mon", "expect": {"tasks": [{"recurrence": {"mode": "due", "every": 1, "unit": "month"}, "extraTokens": ["@repeat-on:mon"]}]}},
    {"id": "catch-up-needs-every", "op": "parse", "input": "- [ ] a @after:1w @repeat-catch-up:yes", "expect": {"tasks": [{"recurrence": {"mode": "completion", "every": 1, "unit": "week"}, "extraTokens": ["@repeat-catch-up:yes"]}]}},
    {"id": "catch-up-only-yes", "op": "parse", "input": "- [ ] a @every:1w @repeat-catch-up:no", "expect": {"tasks": [{"recurrence": {"mode": "due", "every": 1, "unit": "week"}, "extraTokens": ["@repeat-catch-up:no"]}]}},
    {"id": "next-day", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "day"}, "anchor": "2026-11-04", "today": "2026-11-04", "expect": "2026-11-05"},
    {"id": "next-across-year", "op": "next", "rule": {"mode": "due", "every": 3, "unit": "day"}, "anchor": "2026-12-30", "today": "2026-12-30", "expect": "2027-01-02"},
    {"id": "next-week", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "week"}, "anchor": "2026-11-04", "today": "2026-11-04", "expect": "2026-11-11"},
    {"id": "next-month", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "month"}, "anchor": "2026-03-15", "today": "2026-03-15", "expect": "2026-04-15"},
    {"id": "month-end-clamps", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "month"}, "anchor": "2026-01-31", "today": "2026-01-31", "expect": "2026-02-28"},
    {"id": "month-end-clamps-leap", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "month"}, "anchor": "2028-01-31", "today": "2028-01-31", "expect": "2028-02-29"},
    {"id": "clamp-is-sticky", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "month"}, "anchor": "2026-02-28", "today": "2026-02-28", "expect": "2026-03-28"},
    {"id": "twelve-months-from-leap-day", "op": "next", "rule": {"mode": "due", "every": 12, "unit": "month"}, "anchor": "2028-02-29", "today": "2028-02-29", "expect": "2029-02-28"},
    {"id": "months-across-year", "op": "next", "rule": {"mode": "due", "every": 3, "unit": "month"}, "anchor": "2026-11-30", "today": "2026-11-30", "expect": "2027-02-28"},
    {"id": "due-mode-may-stay-in-the-past", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "week"}, "anchor": "2026-01-07", "today": "2026-11-04", "expect": "2026-01-14"},
    {"id": "catch-up-reaches-the-future", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "week", "catchUp": true}, "anchor": "2026-01-07", "today": "2026-11-04", "expect": "2026-11-11"},
    {"id": "catch-up-today-is-not-the-future", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "week", "catchUp": true}, "anchor": "2026-10-28", "today": "2026-11-04", "expect": "2026-11-11"},
    {"id": "catch-up-on-a-current-task", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "week", "catchUp": true}, "anchor": "2026-11-20", "today": "2026-11-04", "expect": "2026-11-27"},
    {"id": "catch-up-passes-until", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "week", "catchUp": true, "until": "2026-06-01"}, "anchor": "2026-01-07", "today": "2026-11-04", "expect": null},
    {"id": "completion-mode", "op": "next", "rule": {"mode": "completion", "every": 3, "unit": "month"}, "anchor": "2026-10-01", "completed": "2026-11-04", "today": "2026-11-05", "expect": "2027-02-04"},
    {"id": "completion-mode-defaults-to-today", "op": "next", "rule": {"mode": "completion", "every": 1, "unit": "week"}, "anchor": "2026-10-01", "today": "2026-11-04", "expect": "2026-11-11"},
    {"id": "weekdays-next-in-set", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "week", "weekdays": [1, 4]}, "anchor": "2026-11-02", "today": "2026-11-02", "expect": "2026-11-05"},
    {"id": "weekdays-wrap-to-next-week", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "week", "weekdays": [1, 4]}, "anchor": "2026-11-05", "today": "2026-11-05", "expect": "2026-11-09"},
    {"id": "two-weekly-fills-the-on-week", "op": "next", "rule": {"mode": "due", "every": 2, "unit": "week", "weekdays": [1, 4]}, "anchor": "2026-11-02", "today": "2026-11-02", "expect": "2026-11-05"},
    {"id": "two-weekly-skips-the-off-week", "op": "next", "rule": {"mode": "due", "every": 2, "unit": "week", "weekdays": [1, 4]}, "anchor": "2026-11-05", "today": "2026-11-05", "expect": "2026-11-16"},
    {"id": "weeks-start-on-sunday", "op": "next", "rule": {"mode": "due", "every": 2, "unit": "week", "weekdays": [0]}, "anchor": "2026-11-01", "today": "2026-11-01", "expect": "2026-11-15"},
    {"id": "weekday-phase-dropped-in-completion-mode", "op": "next", "rule": {"mode": "completion", "every": 2, "unit": "week", "weekdays": [1, 4]}, "anchor": "2026-11-02", "completed": "2026-11-05", "today": "2026-11-05", "expect": "2026-11-09"},
    {"id": "until-is-inclusive", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "week", "until": "2026-11-11"}, "anchor": "2026-11-04", "today": "2026-11-04", "expect": "2026-11-11"},
    {"id": "until-ends-the-series", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "week", "until": "2026-11-10"}, "anchor": "2026-11-04", "today": "2026-11-04", "expect": null},
    {"id": "count-is-ignored-here", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "day", "count": 0}, "anchor": "2026-11-04", "today": "2026-11-04", "expect": "2026-11-05"},
    {"id": "shadowed-orphan-repeat-tokens-are-extras", "op": "parse", "input": "- [ ] a @repeat-count:1 @repeat-count:2", "expect": {"tasks": [{"recurrence": null, "extraTokens": ["@repeat-count:1", "@repeat-count:2"]}]}},
    {"id": "rule-extras-keep-their-place", "op": "parse", "input": "- [ ] a @bogus:1 @repeat-on:mon @other:2 @every:1m", "expect": {"tasks": [{"extraTokens": ["@bogus:1", "@repeat-on:mon", "@other:2"]}]}},
    {"id": "habit-field", "op": "parse", "input": "- [ ] a @every:1d @habit:yes\n- [ ] b @habit:no", "expect": {"tasks": [{"habit": true}, {"habit": false, "extraTokens": ["@habit:no"]}]}},
    {"id": "last-day-of-the-weekday-window", "op": "next", "rule": {"mode": "due", "every": 1, "unit": "week", "weekdays": [3]}, "anchor": "2026-11-04", "today": "2026-11-04", "expect": "2026-11-11"},
    {"id": "catch-up-with-weekdays-keeps-phase", "op": "next", "rule": {"mode": "due", "every": 2, "unit": "week", "weekdays": [1], "catchUp": true}, "anchor": "2026-10-05", "today": "2026-11-04", "expect": "2026-11-16"},
    {"id": "interval-limit", "op": "parse", "input": "- [ ] a @every:9999d\n- [ ] b @every:10000d", "expect": {"tasks": [{"recurrence": {"mode": "due", "every": 9999, "unit": "day"}}, {"recurrence": null, "extraTokens": ["@every:10000d"]}]}}
  ]
}
