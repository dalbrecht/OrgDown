    { "id": "od602-task-before-section", "profile": "tasks-md", "input": "- [ ] **T**", "expect": [{ "code": "OD602", "line": 1 }] },
    { "id": "od602-subheading", "profile": "tasks-md", "input": "## Active\n### Sub", "expect": [{ "code": "OD602", "line": 2 }] },
