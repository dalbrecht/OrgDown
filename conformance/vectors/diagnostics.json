    { "id": "tasks-v2-clean", "profile": "tasks-v2", "input": "## A\n- [ ] a @status:next due:2026-11-04 <!-- id:x rev:1 -->", "expect": [] },

    { "id": "tasks-md-clean", "profile": "tasks-md", "input": "# Tasks\n\n## Active\n\n- [ ] **Send** - for Priya due:2026-11-07\n  - [ ] Sub @context:x\n- [ ] **Plain**\n\n## Waiting On\n\n- [ ] **Sign-off** - from finance\n\n## Done\n\n- [x] **~~Venue~~** - completed:2026-11-02\n", "expect": [] },
    { "id": "od601-unbolded-with-tokens", "profile": "tasks-md", "input": "## Active\n- [ ] Send @priority:1", "expect": [{ "code": "OD601", "line": 2 }] },
