    { "id": "od603-upper-x", "profile": "tasks-md", "input": "## Active\n- [X] **T**", "expect": [{ "code": "OD603", "line": 2 }] },
    { "id": "od603-deep-subtask", "profile": "tasks-md", "input": "## Active\n- [ ] **T**\n  - [ ] a\n    - [ ] b", "expect": [{ "code": "OD603", "line": 4 }] },
    { "id": "od604-status-against-section", "profile": "tasks-md", "input": "## Someday\n- [ ] **T** - @status:next", "expect": [{ "code": "OD604", "line": 2 }] },
    { "id": "od605-open-in-done", "profile": "tasks-md", "input": "## Done\n- [ ] **T**", "expect": [{ "code": "OD605", "line": 2 }] },
    { "id": "od606-prose-date", "profile": "tasks-md", "input": "## Active\n- [ ] **T** - for Sam, due Friday", "expect": [{ "code": "OD606", "line": 2 }] },
    { "id": "od606-not-with-a-token", "profile": "tasks-md", "input": "## Active\n- [ ] **T** - due Friday due:2026-11-06", "expect": [] },
    { "id": "od607-waiting-no-reason", "profile": "tasks-md", "input": "## Waiting On\n- [ ] **T**", "expect": [{ "code": "OD607", "line": 2 }] }
