{
  "name": "orgdown",
  "version": "0.1.0",
  "description": "Reference CLI for OrgDown: Org mode's task and agenda model in plain Markdown.",
  "license": "MIT",
  "type": "module",
  "bin": { "orgdown": "plugin/bin/orgdown.mjs" },
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsc -b && esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=plugin/bin/orgdown.mjs --banner:js='#!/usr/bin/env node'",
    "test": "vitest run --coverage",
    "lint": "tsc --noEmit && prettier --check ."
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "2.1.8",
    "esbuild": "0.24.2",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
