{
  "description": "Checks TASKS.md and tasks.v2.md after Claude writes them, so format problems surface straight away.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/orgdown.mjs\" hook"
          }
        ]
      }
    ]
  }
}
